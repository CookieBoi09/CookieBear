---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-menu">
			<button
				class="nav-menu-button"
				type="button"
				aria-expanded="false"
				aria-controls="navigation-dropdown"
			>
				<span class="menu-icon" aria-hidden="true">☰</span>
				<span class="sr-only">Open navigation menu</span>
			</button>

			<div class="internal-links" id="navigation-dropdown">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/contact">Contact</HeaderLink>
			</div>
		</div>
	</nav>
</header>

<script>
	const navMenu = document.querySelector<HTMLElement>('.nav-menu');
	const navMenuButton = document.querySelector<HTMLButtonElement>('.nav-menu-button');

	const setNavMenuOpen = (isOpen: boolean) => {
		if (!navMenuButton) return;
		navMenuButton.setAttribute('aria-expanded', String(isOpen));
		const label = navMenuButton.querySelector<HTMLElement>('.sr-only');
		if (label) label.textContent = isOpen ? 'Close navigation menu' : 'Open navigation menu';
	};

	navMenuButton?.addEventListener('click', () => {
		setNavMenuOpen(navMenuButton.getAttribute('aria-expanded') !== 'true');
	});

	document.addEventListener('click', (event) => {
		if (event.target instanceof Node && !navMenu?.contains(event.target)) {
			setNavMenuOpen(false);
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || navMenuButton?.getAttribute('aria-expanded') !== 'true') return;
		setNavMenuOpen(false);
		navMenuButton.focus();
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links,
	.nav-menu {
		display: flex;
		align-items: stretch;
	}
	.nav-menu {
		grid-column: 2;
		justify-self: center;
		position: relative;
	}
	.nav-menu-button {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
		color: rgb(var(--black));
		font: inherit;
		cursor: pointer;
	}
	.nav-menu-button:hover,
	.nav-menu-button[aria-expanded='true'] {
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
	}
	.nav-menu-button:focus-visible {
		outline: 3px solid rgba(var(--accent), 15%);
		outline-offset: 2px;
	}
	.menu-icon {
		font-size: 1.4rem;
		line-height: 1;
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.nav-menu {
			grid-column: 2;
			justify-self: end;
		}
		.nav-menu-button {
			display: flex;
		}
		.internal-links {
			position: absolute;
			top: calc(100% + 0.5rem);
			right: 0;
			z-index: 10;
			display: none;
			width: min(14rem, calc(100vw - 2rem));
			padding: 0.5rem;
			border: 1px solid rgb(var(--gray-light));
			border-radius: 12px;
			background: #fff;
			box-shadow: var(--box-shadow);
		}
		.nav-menu-button[aria-expanded='true'] + .internal-links {
			display: flex;
			flex-direction: column;
		}
		.internal-links a {
			padding: 0.65rem 0.75rem;
			border: 0;
			border-radius: 8px;
		}
		.internal-links a:hover,
		.internal-links a:focus-visible {
			background: rgb(var(--gray-light));
			outline: none;
		}
	}
</style>
