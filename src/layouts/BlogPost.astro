---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import '../styles/manuscript.css';

type Props = CollectionEntry<'blog'>['data'] & {
  documentId: string;
  readingMinutes: number;
};

const { title, description, pubDate, updatedDate, heroImage, category, documentId, readingMinutes } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body class="quantum-home quantum-content manuscript-site" id="top">
    <Header />
    <main id="main-content" class="manuscript-reader">
      <nav class="reader-toolbar" aria-label="Journal navigation">
        <a href="/blog/">← All journals</a>
        <span class="reader-mode"><span aria-hidden="true">●</span> Manuscript view</span>
        <button type="button" class="print-manuscript">Print / PDF <span aria-hidden="true">↗</span></button>
      </nav>

      <div class="manuscript-workspace">
        <aside class="document-record" aria-label="Entry details">
          <p class="record-label">Document record</p>
          <p class="record-id">{documentId}</p>
          <dl>
            <dt>Filed under</dt><dd>{category}</dd>
            <dt>Published</dt><dd><FormattedDate date={pubDate} /></dd>
            <dt>Reading time</dt><dd>{readingMinutes} min read</dd>
            {updatedDate && <><dt>Revised</dt><dd><FormattedDate date={updatedDate} /></dd></>}
          </dl>
          <div class="record-rule" aria-hidden="true"></div>
          <p class="record-note">A thought, put to paper.</p>
        </aside>

        <article class="manuscript-sheet" aria-labelledby="manuscript-title">
          <div class="sheet-running-head">
            <span>CookieBear / Journal</span>
            <span>{documentId}</span>
          </div>
          <header class="manuscript-title-block">
            <p class="manuscript-category">{category}</p>
            <h1 id="manuscript-title">{title}</h1>
            <p class="manuscript-byline"><FormattedDate date={pubDate} /><span aria-hidden="true"> / </span>{readingMinutes} min read</p>
            {updatedDate && <p class="manuscript-revision">Revised <FormattedDate date={updatedDate} /></p>}
            <div class="title-divider" aria-hidden="true"><span>✦</span></div>
          </header>

          <div class="manuscript-body">
            <slot />
          </div>

          {heroImage && (
            <figure class="manuscript-figure">
              <Image src={heroImage} alt="" width={720} loading="lazy" />
              <figcaption><span>Fig. 01</span> / {category}</figcaption>
            </figure>
          )}

          <div class="sheet-colophon">
            <span>{documentId}</span><span>End of entry <span aria-hidden="true">∎</span></span>
          </div>
        </article>
      </div>
      <div class="reader-end"><a href="/blog/">← Return to the archive</a><a href="#top">Back to top ↑</a></div>
    </main>
    <Footer />
    <script>
      document.querySelector('.print-manuscript')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
