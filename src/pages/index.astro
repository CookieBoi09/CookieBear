---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { PROJECT_STATUS_LABELS } from '../lib/project-status';
import IsingSignals from '../components/IsingSignals.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import OskiImage from '../assets/blog-placeholder-about.jpg';
import '../styles/quantum-home.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="quantum-home" id="top">
    <Header />
    <main id="main-content" class="quantum-main">
      <section class="quantum-hero" aria-labelledby="hero-title">
        <div class="circuit-field" aria-hidden="true">
          <img class="ising-art" src="/design/ising-circuit.svg" width="1440" height="700" alt="" fetchpriority="high" />
          <div class="quantum-dots">{Array.from({length: 272}, () => <img src="/design/grid-dot.svg" width="2" height="2" alt="" />)}</div>
          <div class="signal-sweep"></div>
          <IsingSignals />
        </div>
        <div class="quantum-container hero-content">
          <p class="q-label entrance">HELLO, WORLD<span class="cursor" aria-hidden="true">_</span></p>
          <h1 id="hero-title" class="entrance">Welcome to<br />my <span>Space!</span></h1>
          <div class="q-actions entrance">
            <a class="q-button primary" href="#projects">Explore projects</a>
          </div>
          <div class="hero-bottom">
          </div>
        </div>
      </section>
      <section class="quantum-about" id="who-am-i" aria-labelledby="about-title">
        <div class="circuit-divider" aria-hidden="true"><img src="/design/circuit-divider.svg" width="1440" height="80" alt="" /></div>
        <div class="quantum-container about-layout">
          <div class="about-copy reveal">
            <p class="q-label gold">THE HUMAN BEHIND THE HARDWARE</p>
            <h2 id="about-title">About Me</h2>
            <p class="q-description">I’m Jerry Fan, a first-year UC Berkeley student interested in the intersection of physics and computer science—and someone who loves sharing ideas and thoughts with the internet.</p>
            <p class="interests">Physics <b>/</b> Software Coding <b>/</b> AI Agents</p>
            <a class="quiet-link" href="/about">A little more about me</a>
          </div>
          <figure class="oski-frame reveal">
            <div class="portrait-window"><img src={OskiImage.src} width={OskiImage.width} height={OskiImage.height} alt="Oski, the UC Berkeley bear, working at a laptop in the library" loading="lazy" /><span class="portrait-scan" aria-hidden="true"></span></div>
            <figcaption><span>BERKELEY / CAL</span><span class="gold">GO BEARS.</span></figcaption>
          </figure>
        </div>
      </section>
      <div class="circuit-divider home-section-divider" aria-hidden="true">
        <img src="/design/project-circuit-divider.svg" width="1440" height="80" alt="" />
        <span></span>
      </div>
      <section class="quantum-projects quantum-container" id="projects" aria-labelledby="projects-title">
        <div class="reveal section-title"><p class="q-label" id="projects-title">CURRENTLY IN DEVELOPMENT</p></div>
        <div class="quantum-card-row">
          {projects.map((project, i) => <article class="oled-card reveal">
            <div class="card-meta"><span>PROJECT_0{i + 1}</span><span class="gold"><i aria-hidden="true"></i>{PROJECT_STATUS_LABELS[project.data.status]}</span></div>
            <h3 class="terminal project-terminal"><a href="/projects"><span aria-hidden="true">&gt; </span>{project.data.title}<span class="cursor" aria-hidden="true">_</span></a></h3>
            <p>{project.data.description}</p>
            <div class="card-bottom"><a class="quiet-link" href="/projects">VIEW PROJECT</a><FormattedDate date={project.data.date} /></div>
          </article>)}
          <article class="oled-card journal-card reveal">
            <div class="card-meta"><span>THE JOURNAL</span><a href="/blog" class="gold">ALL ENTRIES</a></div>
            <div class="terminal" aria-hidden="true">&gt; thoughts into words<span class="cursor">_</span></div>
            <h3>Recent Blog Posts</h3>
            <ul>{posts.map(post => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a><FormattedDate date={post.data.pubDate} /></li>)}</ul>
          </article>
        </div>
      </section>
    </main>
    <footer class="quantum-footer quantum-container">
      <a class="footer-brand" href="/"><img src="/cookie-icon-transparent.png" width="389" height="396" alt="" />{SITE_TITLE}</a>
      <p><span class="gold">Powered by coffee and fruit teas</span></p>
      <a href="#top">BACK TO TOP</a>
    </footer>
    <script>
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const applyMotion = () => document.body.classList.toggle('motion-paused', reducedMotion.matches);
      applyMotion();
      reducedMotion.addEventListener('change', applyMotion);
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) if (entry.isIntersecting) {
            entry.target.classList.add('is-visible'); observer.unobserve(entry.target);
          }
        }, { threshold: .12 });
        document.querySelectorAll('.reveal').forEach(element => {
          element.classList.add('will-reveal'); observer.observe(element);
        });
      }
    </script>
  </body>
</html>
