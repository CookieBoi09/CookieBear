---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="latest-section">
        <h2>Latest Posts</h2>

        <div class="post-grid">
          {
            recentPosts.map((post) => (
              <article class="post-card">
                <a href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <img src={post.data.heroImage.src} alt={post.data.title} />
                  )}
                </a>

                <p class="post-meta">
                  {post.data.pubDate.toLocaleDateString()}
                </p>

                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
              </article>
            ))
          }
        </div>
      </section>

      <section class="project-section">
        <p class="eyebrow">Current Project</p>
        <div class="project-card">
          <div>
            <h2>CookieBear Blog</h2>
            <p>
              A personal corner of the web for writing about life, college,
              Berkeley classes, and the ideas I am exploring along the way.
            </p>
          </div>

          <div class="project-links">
            <a class="primary-link" href="/blog">Read the blog</a>
            <a
              class="secondary-link"
              href="https://github.com/CookieBoi09/CookieBear"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .latest-section,
  .project-section {
    margin-bottom: 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 300px));
    gap: 2rem;
    justify-content: end;
  }

  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  .post-card h3 {
    font-size: 0.95rem;
    line-height: 1.2;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;

    overflow: hidden;
    min-height: 2.4em;
  }

  .post-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: rgb(var(--gray));
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(var(--gray), 12%);
  }

  .project-card h2 {
    margin-bottom: 0.5rem;
  }

  .project-card p {
    max-width: 34rem;
    margin: 0;
    color: rgb(var(--gray));
  }

  .project-links {
    display: flex;
    flex-shrink: 0;
    gap: 0.75rem;
  }

  .project-links a {
    padding: 0.55rem 0.9rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .project-links .primary-link {
    border-color: rgb(var(--accent));
    background: rgb(var(--accent));
    color: #fff;
  }

  .project-links .secondary-link {
    color: rgb(var(--gray-dark));
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      align-items: start;
      flex-direction: column;
    }

    .project-links {
      flex-wrap: wrap;
    }
  }
</style>
