---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = await getCollection('projects');
const recentProject = projects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="latest-section">
        <div class="section-heading">
          <h2>Latest Posts</h2>
          <div class="carousel-controls" aria-label="Latest post navigation">
            <button class="carousel-button previous" type="button" aria-label="Previous post">
              <span aria-hidden="true">←</span>
            </button>
            <button class="carousel-button next" type="button" aria-label="Next post">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>

        <div class="post-grid" id="latest-posts">
          {
            recentPosts.map((post) => (
              <article class="post-card">
                <a href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <img src={post.data.heroImage.src} alt={post.data.title} />
                  )}
                </a>

                <p class="post-meta">
                  {post.data.pubDate.toLocaleDateString()}
                </p>

                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
              </article>
            ))
          }
        </div>
      </section>

      <section class="project-section">
        <p class="eyebrow">Current Project</p>
        <div class="project-card">
          <div>
            <h2>CookieBear Blog</h2>
            <p>
              A personal project I've started out of my willingness to share
              wisdom I have gained throughout my life
            </p>
          </div>

          <div class="project-links">
            <a class="primary-link" href="/blog">Read the blog</a>
            <a
              class="secondary-link"
              href="https://github.com/CookieBoi09/CookieBear"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </div>
        </div>

        {
          recentProject && (
            <article class="project-card">
              <div class="project-meta">
                <p class:list={['project-status', recentProject.data.status]}>
                  {recentProject.data.status}
                </p>
                <p class="project-date">
                  <FormattedDate date={recentProject.data.date} />
                </p>
              </div>

              <h3>{recentProject.data.title}</h3>
              <p class="project-description">{recentProject.data.description}</p>
            </article>
          )
        }
      </section>
    </main>

    <Footer />

    <script>
      const carousel = document.querySelector<HTMLElement>('#latest-posts');
      const previousButton = document.querySelector<HTMLButtonElement>('.carousel-button.previous');
      const nextButton = document.querySelector<HTMLButtonElement>('.carousel-button.next');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const updateCarouselButtons = () => {
        if (!carousel || !previousButton || !nextButton) return;

        const scrollEnd = carousel.scrollWidth - carousel.clientWidth;
        previousButton.disabled = carousel.scrollLeft <= 1;
        nextButton.disabled = carousel.scrollLeft >= scrollEnd - 1;
      };

      const slidePosts = (direction: -1 | 1) => {
        if (!carousel) return;

        const card = carousel.querySelector<HTMLElement>('.post-card');
        const gap = Number.parseFloat(getComputedStyle(carousel).gap) || 0;
        const distance = card ? card.offsetWidth + gap : carousel.clientWidth;

        carousel.scrollBy({
          left: direction * distance,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };

      previousButton?.addEventListener('click', () => slidePosts(-1));
      nextButton?.addEventListener('click', () => slidePosts(1));
      carousel?.addEventListener('scroll', updateCarouselButtons, { passive: true });
      window.addEventListener('resize', updateCarouselButtons);
      updateCarouselButtons();
    </script>
  </body>
</html>

<style>
  .latest-section,
  .project-section {
    margin-bottom: 4rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .carousel-controls {
    display: none;
    gap: 0.5rem;
  }

  .carousel-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 50%;
    background: #fff;
    color: rgb(var(--gray-dark));
    font: inherit;
    cursor: pointer;
  }

  .carousel-button:hover:not(:disabled) {
    border-color: rgb(var(--accent));
    color: rgb(var(--accent));
  }

  .carousel-button:focus-visible {
    outline: 3px solid rgba(var(--accent), 15%);
    outline-offset: 2px;
  }

  .carousel-button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 300px));
    gap: 2rem;
    justify-content: end;
  }

  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  .post-card h3 {
    font-size: 0.95rem;
    line-height: 1.2;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;

    overflow: hidden;
    min-height: 2.4em;
  }

  .post-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-heading {
    margin-bottom: 1rem;
  }

  .project-heading a {
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(var(--gray), 12%);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-status {
    margin: 0;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .project-status.ongoing {
    background: rgba(35, 55, 255, 10%);
    color: var(--accent);
  }

  .project-status.past {
    background: rgb(var(--gray-light));
    color: rgb(var(--gray-dark));
  }

  .project-date {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.85rem;
  }

  .project-card h3 {
    margin-bottom: 0.6rem;
    font-size: 1.563rem;
  }

  .project-description {
    max-width: 40rem;
    margin: 0;
    color: rgb(var(--gray));
  }

  @media (max-width: 720px) {
    .carousel-controls {
      display: flex;
    }

    .post-grid {
      display: flex;
      justify-content: start;
      gap: 1rem;
      margin-inline: -1rem;
      padding: 0.25rem 1rem 1rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-behavior: smooth;
      scroll-padding-inline: 1rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      touch-action: pan-x;
    }

    .post-grid::-webkit-scrollbar {
      display: none;
    }

    .post-card {
      flex: 0 0 88%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .post-grid {
      scroll-behavior: auto;
    }
  }
</style>
