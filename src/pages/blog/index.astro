---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

import { SITE_TITLE } from '../../consts';
import { manuscriptDetails } from '../../lib/blog-manuscript';
import '../../styles/manuscript.css';

const posts = (
  await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  })
).sort((a, b) => {
  const dateDifference = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

  if (dateDifference !== 0) return dateDifference;

  return b.data.title.localeCompare(a.data.title, 'en', { numeric: true, sensitivity: 'base' });
});

const categories = [
  ...new Set(['Series #1', ...posts.map((post) => post.data.category)]),
].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Journal Bounty Board | ${SITE_TITLE}`} description="Field notes on life, learning, and building. Explore the CookieBear journal board." />
  </head>

  <body class="quantum-home quantum-content manuscript-site" id="top">
    <Header />

    <main id="main-content" class="blog-page manuscript-archive">
      <div class="page-intro">
        <div class="board-masthead">
          <p class="eyebrow">CookieBear / Bounty notes</p>
          <span class="board-access"><span aria-hidden="true">●</span> Public archive</span>
        </div>
        <div class="board-intro-grid">
          <div>
            <h1>Bounty Board</h1>
            <p class="board-description">Go on traveler...pick any article you so please to read</p>
          </div>
          <aside class="board-register" aria-label="Archive overview">
            <span class="register-crosshair" aria-hidden="true">⌖</span>
            <span class="register-label">Posted journals</span>
            <strong>{String(posts.length).padStart(2, '0')}</strong>
            <span class="board-barcode" aria-hidden="true"></span>
          </aside>
        </div>
      </div>
      <section>
        <div class="filters">
          <div class="catalogue-heading">
            <span class="catalogue-name">
              <span aria-hidden="true">⌕</span> Locate a journal
            </span>
            <output id="search-results-count" aria-live="polite" aria-atomic="true">{posts.length} of {posts.length} journals</output>
          </div>
          <div class="filter-field search">
            <label for="blog-search">Search the board</label>
            <div class="catalogue-search">
              <svg class="catalogue-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
              <input
                id="blog-search"
                type="search"
                placeholder="Title, date, or journal number…"
                autocomplete="off"
                aria-controls="blog-posts"
              />
              <button class="clear-search" type="button" aria-label="Clear search" hidden>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
              </button>
            </div>
          </div>

          <fieldset class="category-filter">
            <legend>Filter by subject</legend>
            <div class="category-options" aria-controls="blog-posts">
              {
                [{ label: 'All journals', value: '' }, ...categories.map((category) => ({ label: category, value: category }))].map(({ label, value }) => (
                  <button
                    type="button"
                    data-filter-category={value}
                    aria-pressed={value === '' ? 'true' : 'false'}
                  >
                    <span class="filter-marker" aria-hidden="true">+</span>
                    <span>{label}</span>
                    <span class="shelf-count">{value === '' ? posts.length : posts.filter((post) => post.data.category === value).length}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>

        <p class="no-results" hidden>No posts match your search.</p>

        <div class="board-list-heading"><h2>Posted on the board</h2><span>Most recent first <span aria-hidden="true">↓</span></span></div>
        <ul id="blog-posts">
          {
            posts.map((post) => {
              const { documentId, excerpt } = manuscriptDetails(post.id, post.body);
              return (
                <li
                  data-search={`${documentId} ${post.data.title} ${post.data.description} ${post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}`.toLowerCase()}
                  data-category={post.data.category}
                >
                  <a href={`/blog/${post.id}/`} class="manuscript-cover">
                    <div class="poster-heading"><span class="poster-wanted" aria-hidden="true">Wanted</span><span class="poster-number">{documentId}</span></div>
                    {post.data.heroImage && (
                      <div class="poster-image">
                        <Image width={720} height={360} src={post.data.heroImage} alt="" class="cover-image" />
                      </div>
                    )}
                    <div class="cover-running-head">
                      <span>Journal / {post.data.category}</span>
                    </div>
                    <h2 class="title">{post.data.title}</h2>
                    <p class="cover-excerpt">{excerpt}</p>
                    <div class="cover-footer">
                      <p class="date"><FormattedDate date={post.data.pubDate} /></p>
                      <span class="cover-open">Open journal <span aria-hidden="true">↗</span></span>
                    </div>
                    <div class="poster-tail" aria-hidden="true"><span class="poster-barcode"></span><span>CookieBear / Field notes</span></div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>

    <Footer />

    <script>
      const searchInput =
        document.querySelector<HTMLInputElement>('#blog-search');
      const categoryButtons = document.querySelectorAll<HTMLButtonElement>(
        '[data-filter-category]',
      );
      const postItems =
        document.querySelectorAll<HTMLElement>('#blog-posts li');
      const noResults = document.querySelector<HTMLElement>('.no-results');
      const clearSearch = document.querySelector<HTMLButtonElement>('.clear-search');
      const resultsCount = document.querySelector<HTMLOutputElement>('#search-results-count');
      const selectedCategories = new Set<string>();

      const updateCategoryButtons = () => {
        categoryButtons.forEach((button) => {
          const category = button.dataset.filterCategory ?? '';
          const isSelected =
            category === ''
              ? selectedCategories.size === 0
              : selectedCategories.has(category);
          button.setAttribute('aria-pressed', String(isSelected));
        });
      };

      const filterPosts = () => {
        const query = searchInput?.value.trim().toLowerCase() ?? '';
        let visiblePosts = 0;

        postItems.forEach((post) => {
          const matchesSearch = post.dataset.search?.includes(query) ?? false;
          const matchesCategory =
            selectedCategories.size === 0 ||
            (post.dataset.category !== undefined &&
              selectedCategories.has(post.dataset.category));
          const isVisible = matchesSearch && matchesCategory;

          post.hidden = !isVisible;
          if (isVisible) visiblePosts += 1;
        });

        if (noResults) noResults.hidden = visiblePosts !== 0;
        if (clearSearch) clearSearch.hidden = !searchInput?.value;
        if (resultsCount) resultsCount.textContent = `${visiblePosts} of ${postItems.length} journals`;
      };

      searchInput?.addEventListener('input', filterPosts);
      clearSearch?.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        filterPosts();
        searchInput.focus();
      });
      categoryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const category = button.dataset.filterCategory ?? '';

          if (category === '') {
            selectedCategories.clear();
          } else if (selectedCategories.has(category)) {
            selectedCategories.delete(category);
          } else {
            selectedCategories.add(category);
          }

          updateCategoryButtons();
          filterPosts();
        });
      });
    </script>
  </body>
</html>

<style>
  @layer original {
    main {
      width: 960px;
    }

    .filters {
      margin-bottom: 2rem;
    }

    .filter-field label {
      display: block;
      margin-bottom: 0.35rem;
      color: rgb(var(--black));
      font-weight: 700;
    }

    .filter-field input {
      box-sizing: border-box;
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid rgb(var(--gray-light));
      border-radius: 12px;
      background: #fff;
      color: rgb(var(--gray-dark));
      font: inherit;
      box-shadow: 0 2px 6px rgba(var(--gray), 12%);
    }

    .filter-field input:focus {
      border-color: rgb(var(--accent));
      outline: 3px solid rgba(var(--accent), 15%);
    }

    .category-filter {
      margin: 1rem 0 0;
      padding: 0;
      border: 0;
    }

    .category-filter legend {
      margin-bottom: 0.35rem;
      color: rgb(var(--black));
      font-weight: 700;
    }

    .category-options {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .category-options button {
      padding: 0.4rem 0.85rem;
      border: 1px solid rgb(var(--gray-light));
      border-radius: 999px;
      background: #fff;
      color: rgb(var(--gray-dark));
      font: inherit;
      font-size: 0.9rem;
      line-height: 1.4;
      cursor: pointer;
      transition:
        color 0.2s ease,
        background-color 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .category-options button:hover {
      border-color: rgb(var(--accent));
      color: rgb(var(--accent));
    }

    .category-options button[aria-pressed='true'] {
      border-color: rgb(var(--gray));
      background: rgb(var(--gray-light));
      color: rgb(var(--gray-dark));
      box-shadow: 0 2px 6px rgba(var(--gray), 18%);
    }

    .category-options button:focus-visible {
      outline: 3px solid rgba(var(--accent), 15%);
      outline-offset: 2px;
    }

    .no-results {
      margin: 0;
      color: rgb(var(--gray));
      text-align: center;
    }

    ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
      list-style-type: none;
      margin: 0;
      padding: 0;
    }

    ul li {
      min-width: 0;
    }

    ul li * {
      text-decoration: none;
      transition: 0.2s ease;
    }

    ul li img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      margin-bottom: 0.5rem;
      border-radius: 12px;
    }

    ul li a {
      display: block;
    }

    .category {
      display: inline-block;
      margin: 0 0 0.5rem;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      background: rgb(var(--gray-light));
      color: rgb(var(--gray-dark));
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .title {
      margin: 0;
      color: rgb(var(--black));
      line-height: 1;
    }

    .date {
      margin: 0;
      color: rgb(var(--gray));
    }

    ul li a:hover h4,
    ul li a:hover .date {
      color: rgb(var(--accent));
    }

    ul a:hover img {
      box-shadow: var(--box-shadow);
    }

    @media (max-width: 720px) {
      ul {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      ul li {
        text-align: center;
      }
    }
  }
</style>
