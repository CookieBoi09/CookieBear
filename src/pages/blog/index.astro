---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const getJournalNumber = (description: string) => {
  const match = description.match(/\bJournal\s+(\d+)\b/i);
  return match ? Number(match[1]) : -1;
};

const posts = (
  await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  })
).sort((a, b) => {
  const dateDifference = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

  if (dateDifference !== 0) return dateDifference;

  return getJournalNumber(b.data.description) - getJournalNumber(a.data.description);
});

const categories = [...new Set(posts.map((post) => post.data.category))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section>
        <div class="filters">
          <div class="filter-field search">
            <label for="blog-search">Search posts</label>
            <input
              id="blog-search"
              type="search"
              placeholder="Search blog posts..."
              autocomplete="off"
              aria-controls="blog-posts"
            />
          </div>

          <fieldset class="category-filter">
            <legend>Category</legend>
            <div class="category-options" aria-controls="blog-posts">
              <button type="button" data-filter-category="" aria-pressed="true">All</button>
              {
                categories.map((category) => (
                  <button type="button" data-filter-category={category} aria-pressed="false">
                    {category}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>

        <p class="no-results" hidden>No posts match your search.</p>

        <ul id="blog-posts">
          {
            posts.map((post) => (
              <li
                data-search={`${post.data.title} ${post.data.description} ${post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}`.toLowerCase()}
                data-category={post.data.category}
              >
                <a href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt=""
                    />
                  )}

                  <p class="category">{post.data.category}</p>

                  <h4 class="title">{post.data.title}</h4>

                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <Footer />

    <script>
      const searchInput = document.querySelector<HTMLInputElement>('#blog-search');
      const categoryButtons = document.querySelectorAll<HTMLButtonElement>(
        '[data-filter-category]'
      );
      const postItems = document.querySelectorAll<HTMLElement>('#blog-posts li');
      const noResults = document.querySelector<HTMLElement>('.no-results');
      const selectedCategories = new Set<string>();

      const updateCategoryButtons = () => {
        categoryButtons.forEach((button) => {
          const category = button.dataset.filterCategory ?? '';
          const isSelected =
            category === '' ? selectedCategories.size === 0 : selectedCategories.has(category);
          button.setAttribute('aria-pressed', String(isSelected));
        });
      };

      const filterPosts = () => {
        const query = searchInput?.value.trim().toLowerCase() ?? '';
        let visiblePosts = 0;

        postItems.forEach((post) => {
          const matchesSearch = post.dataset.search?.includes(query) ?? false;
          const matchesCategory =
            selectedCategories.size === 0 ||
            (post.dataset.category !== undefined && selectedCategories.has(post.dataset.category));
          const isVisible = matchesSearch && matchesCategory;

          post.hidden = !isVisible;
          if (isVisible) visiblePosts += 1;
        });

        if (noResults) noResults.hidden = visiblePosts !== 0;
      };

      searchInput?.addEventListener('input', filterPosts);
      categoryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const category = button.dataset.filterCategory ?? '';

          if (category === '') {
            selectedCategories.clear();
          } else if (selectedCategories.has(category)) {
            selectedCategories.delete(category);
          } else {
            selectedCategories.add(category);
          }

          updateCategoryButtons();
          filterPosts();
        });
      });
    </script>
  </body>
</html>

<style>
  main {
    width: 960px;
  }

  .filters {
    margin-bottom: 2rem;
  }

  .filter-field label {
    display: block;
    margin-bottom: 0.35rem;
    color: rgb(var(--black));
    font-weight: 700;
  }

  .filter-field input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
    background: #fff;
    color: rgb(var(--gray-dark));
    font: inherit;
    box-shadow: 0 2px 6px rgba(var(--gray), 12%);
  }

  .filter-field input:focus {
    border-color: rgb(var(--accent));
    outline: 3px solid rgba(var(--accent), 15%);
  }

  .category-filter {
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
  }

  .category-filter legend {
    margin-bottom: 0.35rem;
    color: rgb(var(--black));
    font-weight: 700;
  }

  .category-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-options button {
    padding: 0.4rem 0.85rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 999px;
    background: #fff;
    color: rgb(var(--gray-dark));
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.4;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-options button:hover {
    border-color: rgb(var(--accent));
    color: rgb(var(--accent));
  }

  .category-options button[aria-pressed='true'] {
    border-color: rgb(var(--gray));
    background: rgb(var(--gray-light));
    color: rgb(var(--gray-dark));
    box-shadow: 0 2px 6px rgba(var(--gray), 18%);
  }

  .category-options button:focus-visible {
    outline: 3px solid rgba(var(--accent), 15%);
    outline-offset: 2px;
  }

  .no-results {
    margin: 0;
    color: rgb(var(--gray));
    text-align: center;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  ul li {
    min-width: 0;
  }

  ul li * {
    text-decoration: none;
    transition: 0.2s ease;
  }

  ul li img {
    width: 100%;
    margin-bottom: 0.5rem;
    border-radius: 12px;
  }

  ul li a {
    display: block;
  }

  .category {
    display: inline-block;
    margin: 0 0 0.5rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgb(var(--gray-light));
    color: rgb(var(--gray-dark));
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .title {
    margin: 0;
    color: rgb(var(--black));
    line-height: 1;
  }

  .date {
    margin: 0;
    color: rgb(var(--gray));
  }

  ul li a:hover h4,
  ul li a:hover .date {
    color: rgb(var(--accent));
  }

  ul a:hover img {
    box-shadow: var(--box-shadow);
  }

  @media (max-width: 720px) {
    ul {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    ul li {
      text-align: center;
    }
  }
</style>
